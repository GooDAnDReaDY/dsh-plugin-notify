{
  "name": "@goodandready-private/dsh-plugin-notify",
  "version": "0.2.3",
  "description": "Fork of @dsh-suite/plugin-notify with excludeSessionPrefixes for messenger-gateway sessions.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.8"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GooDAnDReaDY/dsh-plugin-notify.git"
  },
  "homepage": "https://github.com/goodandready-private/dsh-plugin-notify#readme",
  "bugs": {
    "url": "https://github.com/goodandready-private/dsh-plugin-notify/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
